FROM ubuntu:22.04

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    postgresql-client \
    libpq-dev \
    libpqxx-dev \
    libboost-all-dev \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . /app/

RUN rm -rf /app/build && \
    mkdir -p /app/build && \
    cd /app/build && \
    cmake -DCMAKE_VERBOSE_MAKEFILE=ON .. && \
    make -j$(nproc) || make VERBOSE=1

EXPOSE 8000

ENV COMP_ANALYZER_WEB_STATIC=/app/web/static

ENTRYPOINT ["/app/build/competence-analyzer-web"]
